@page "/flashcards"
@using LearnLuxembourgish.Shared.Models
@using Microsoft.Extensions.Logging
@using System.Net
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ILogger<FlashCards> Logger
@rendermode InteractiveServer

<PageTitle>Flash Cards</PageTitle>

<div class="container mt-4">
    <h1>Flash Cards</h1>

    <div class="mb-3 d-flex gap-2 align-items-center">
        <label class="form-label mb-0 fw-bold">Deck:</label>
        <select class="form-select w-auto" @bind="SelectedDeck" @bind:after="LoadCardsAsync">
            <option value="">All decks</option>
            @foreach (var deck in Decks)
            {
                <option value="@deck">@deck</option>
            }
        </select>
    </div>

    @if (ErrorMessage is not null)
    {
        <div class="alert alert-danger">
            @ErrorMessage
        </div>
    }

    @if (IsLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else if (Cards.Count == 0 && ErrorMessage is null)
    {
        <div class="alert alert-info">
            No flash cards yet. <a href="/translate">Translate a phrase</a> and save it!
        </div>
    }
    else if (Cards.Count > 0)
    {
        @if (!IsReviewMode)
        {
            <button class="btn btn-primary mb-3" @onclick="StartReview">Start Review (@Cards.Count cards)</button>

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
                @foreach (var card in Cards)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-body">
                                <p class="card-text text-muted small">@card.SourceText</p>
                                <p class="card-text fw-bold fs-5">@card.TranslatedText</p>
                                @if (card.AudioUrl is not null)
                                {
                                    <audio controls src="@card.AudioUrl" class="w-100 mb-2"></audio>
                                }
                                <span class="badge bg-secondary">@card.DeckName</span>
                                <span class="badge bg-info ms-1">Reviewed: @card.ReviewCount</span>
                            </div>
                            <div class="card-footer">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCardAsync(card.Id)">
                                    Delete
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span>Card @(ReviewIndex + 1) of @Cards.Count</span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="() => IsReviewMode = false">Exit Review</button>
            </div>

            <div class="card text-center shadow-lg" style="min-height: 300px; cursor: pointer;" @onclick="FlipCard">
                <div class="card-body d-flex flex-column justify-content-center align-items-center p-5">
                    @if (!IsFlipped)
                    {
                        <h4 class="card-title text-muted">@Cards[ReviewIndex].SourceText</h4>
                        <p class="text-muted mt-3">Click to reveal translation</p>
                    }
                    else
                    {
                        <h2 class="card-title text-primary">@Cards[ReviewIndex].TranslatedText</h2>
                        @if (Cards[ReviewIndex].GrammarExplanation is not null)
                        {
                            <p class="mt-3 text-start" style="white-space: pre-wrap; font-size: 0.9em;">@Cards[ReviewIndex].GrammarExplanation</p>
                        }
                        @if (Cards[ReviewIndex].AudioUrl is not null)
                        {
                            <audio controls src="@Cards[ReviewIndex].AudioUrl" class="mt-3"></audio>
                        }
                    }
                </div>
            </div>

            <div class="d-flex justify-content-center gap-3 mt-4">
                <button class="btn btn-outline-primary" @onclick="PreviousCard" disabled="@(ReviewIndex == 0)">Previous</button>
                <button class="btn btn-success" @onclick="NextCardWithReview">Mark as Reviewed</button>
                <button class="btn btn-outline-primary" @onclick="NextCard" disabled="@(ReviewIndex >= Cards.Count - 1)">Next</button>
            </div>
        }
    }
</div>

@code {
    private List<FlashCardDto> Cards { get; set; } = [];
    private List<string> Decks { get; set; } = [];
    private string SelectedDeck { get; set; } = string.Empty;
    private bool IsLoading { get; set; } = true;
    private bool IsReviewMode { get; set; }
    private bool IsFlipped { get; set; }
    private int ReviewIndex { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsAuthError { get; set; }
    private bool _hasRendered = false;

    // Use OnAfterRenderAsync instead of OnInitializedAsync to avoid JSInterop prerendering issues
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hasRendered)
        {
            _hasRendered = true;
            await LoadCardsAsync();
            StateHasChanged();
        }
    }

    private async Task LoadCardsAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        IsAuthError = false;

        try
        {
            var url = string.IsNullOrEmpty(SelectedDeck)
                ? "api/flashcards"
                : $"api/flashcards?deck={Uri.EscapeDataString(SelectedDeck)}";

            Logger.LogInformation("Loading flashcards from {Url}", url);

            // HttpClient automatically gets auth header via DelegatingHandler
            var response = await Http.GetAsync(url);

            Logger.LogInformation("FlashCards API response: {StatusCode}", response.StatusCode);

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                IsAuthError = true;
                ErrorMessage = "You need to log in to access your flash cards.";
                Logger.LogWarning("Unauthorized access to flashcards");
                return;
            }

            response.EnsureSuccessStatusCode();
            Cards = await response.Content.ReadFromJsonAsync<List<FlashCardDto>>() ?? [];
            Decks = Cards.Select(c => c.DeckName).Distinct().Order().ToList();
            Logger.LogInformation("Loaded {Count} flashcards successfully", Cards.Count);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            IsAuthError = true;
            ErrorMessage = "You need to log in to access your flash cards.";
            Logger.LogWarning(ex, "Unauthorized HTTP request to flashcards");
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error loading flash cards: {ex.Message}";
            Logger.LogError(ex, "Error loading flashcards");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void StartReview()
    {
        ReviewIndex = 0;
        IsFlipped = false;
        IsReviewMode = true;
    }

    private void FlipCard() => IsFlipped = !IsFlipped;

    private void NextCard()
    {
        if (ReviewIndex < Cards.Count - 1)
        {
            ReviewIndex++;
            IsFlipped = false;
        }
    }

    private void PreviousCard()
    {
        if (ReviewIndex > 0)
        {
            ReviewIndex--;
            IsFlipped = false;
        }
    }

    private async Task NextCardWithReview()
    {
        try
        {
            // HttpClient automatically gets auth header via DelegatingHandler
            await Http.PatchAsync($"api/flashcards/{Cards[ReviewIndex].Id}/review", null);
            NextCard();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            IsAuthError = true;
            ErrorMessage = "Your session has expired. Please log in again.";
            IsReviewMode = false;
        }
    }

    private async Task DeleteCardAsync(Guid id)
    {
        try
        {
            // HttpClient automatically gets auth header via DelegatingHandler
            var response = await Http.DeleteAsync($"api/flashcards/{id}");

            if (response.StatusCode == HttpStatusCode.Unauthorized)
            {
                IsAuthError = true;
                ErrorMessage = "Your session has expired. Please log in again.";
                return;
            }

            response.EnsureSuccessStatusCode();
            await LoadCardsAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Unauthorized)
        {
            IsAuthError = true;
            ErrorMessage = "Your session has expired. Please log in again.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error deleting flash card: {ex.Message}";
        }
    }
}
