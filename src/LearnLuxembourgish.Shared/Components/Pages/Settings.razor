@page "/settings"
@using LearnLuxembourgish.Shared.Services
@inject UserSettingsService UserSettings
@rendermode InteractiveServer

<PageTitle>Settings – Learn Luxembourgish</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-6">
    <MudText Typo="Typo.h4" GutterBottom="true">Settings</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
        Configure your grammar analysis preferences. Settings are stored locally in your browser.
    </MudText>

    @if (!_loaded)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
    }
    else
    {
        <MudCard Elevation="2" Class="mb-4">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Grammar Analysis Provider</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudText Typo="Typo.body2" Class="mb-4">
                    Choose between the Mistral AI API (cloud) or a locally hosted model via Ollama.
                    The local option requires Ollama running on your machine.
                </MudText>

                <MudRadioGroup T="string" @bind-Value="_provider">
                    <MudRadio T="string" Value="@("mistral")" Color="Color.Primary">
                        <MudText>
                            <strong>Mistral AI</strong> — cloud API, highest quality grammar breakdowns
                        </MudText>
                    </MudRadio>
                    <MudRadio T="string" Value="@("local")" Color="Color.Secondary" Class="mt-2">
                        <MudText>
                            <strong>Local model</strong> — Ollama, runs on your machine (no API key needed)
                        </MudText>
                    </MudRadio>
                </MudRadioGroup>
            </MudCardContent>
        </MudCard>

        @if (_provider == "mistral")
        {
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Mistral API Key</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.body2" Class="mb-3">
                        Enter your
                        <MudLink Href="https://console.mistral.ai/api-keys/" Target="_blank">Mistral API key</MudLink>.
                        If left blank, the server-configured key is used (available in local dev via user secrets).
                        The key is stored only in your browser's localStorage — it is never sent to our servers
                        except as part of the grammar analysis request over HTTPS.
                    </MudText>

                    <MudTextField T="string"
                                  Label="Mistral API Key"
                                  @bind-Value="_mistralApiKey"
                                  InputType="@(_showKey ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showKey = !_showKey)"
                                  Placeholder="sk-..."
                                  HelperText="Stored in browser localStorage only"
                                  FullWidth="true"
                                  Variant="Variant.Outlined" />
                </MudCardContent>
            </MudCard>
        }

        @if (_saveMessage is not null)
        {
            <MudAlert Severity="@_saveSeverity" Class="mb-4" ShowCloseIcon="true"
                      CloseIconClicked="@(() => _saveMessage = null)">
                @_saveMessage
            </MudAlert>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                   StartIcon="@Icons.Material.Filled.Save" Disabled="_saving">
            @(_saving ? "Saving..." : "Save Settings")
        </MudButton>
    }
</MudContainer>

@code {
    private bool _loaded;
    private bool _saving;
    private bool _showKey;
    private string _provider = "mistral";
    private string? _mistralApiKey;
    private string? _saveMessage;
    private Severity _saveSeverity = Severity.Success;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await UserSettings.LoadAsync();
            _provider      = UserSettings.GrammarProvider;
            _mistralApiKey = UserSettings.MistralApiKey;
            _loaded = true;
            StateHasChanged();
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saveMessage = null;
        StateHasChanged();

        try
        {
            UserSettings.GrammarProvider = _provider;
            UserSettings.MistralApiKey   = _mistralApiKey;
            await UserSettings.SaveAsync();
            _saveSeverity = Severity.Success;
            _saveMessage = "Settings saved successfully.";
        }
        catch
        {
            _saveSeverity = Severity.Error;
            _saveMessage = "Failed to save settings. Please try again.";
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
