# ============================================================
# LearnLuxembourgish — Docker runtime secrets template
# ============================================================
# Copy this file to .env and fill in real values.
# .env is GITIGNORED — never commit it.
#
#   cp .env.template .env
#   # edit .env with real values
#   docker compose up
# ============================================================

# ── Docker Hub ────────────────────────────────────────────────
DOCKER_USERNAME=yourdockerhubusername
IMAGE_TAG=latest

# ── API — REQUIRED ────────────────────────────────────────────
# A strong random secret, e.g.: openssl rand -base64 48
Jwt__SecretKey=CHANGE_ME_strong_random_secret_at_least_32_chars

AzureAd__Instance=https://login.microsoftonline.com/
AzureAd__TenantId=CHANGE_ME_your-azure-ad-tenant-id
AzureAd__ClientId=CHANGE_ME_your-azure-ad-client-id

# ── API — Optional (features degrade gracefully if absent) ────
Translation__DeepL__ApiKey=
Translation__Mistral__ApiKey=
Grammar__Mistral__ApiKey=
Grammar__Groq__ApiKey=

# Ollama endpoint if you run a local LLM (leave blank to disable)
Translation__Ollama__Endpoint=
Grammar__Ollama__Endpoint=

# ── API — Database ────────────────────────────────────────────
# The docker-compose.yml mounts ./data/learnlux.db to /data/learnluxembourgish.db
# inside the container.  Change the path here if you want a different host location.
ConnectionStrings__DefaultConnection=Data Source=/data/learnluxembourgish.db
