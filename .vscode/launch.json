{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Aspire: AppHost (Dashboard + All Services)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/LearnLuxembourgish.AppHost/bin/Debug/net10.0/LearnLuxembourgish.AppHost.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/LearnLuxembourgish.AppHost",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            },
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "MAUI: Windows",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-mobile-windows",
            "program": "${workspaceFolder}/src/LearnLuxembourgish.Mobile/bin/Debug/net10.0-windows10.0.19041.0/win-x64/LearnLuxembourgish.Mobile.exe",
            "args": [],
            "cwd": "${workspaceFolder}/src/LearnLuxembourgish.Mobile/bin/Debug/net10.0-windows10.0.19041.0/win-x64",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            }
        },
        {
            // Used by the compound — AppHost without its own pre-build (build-mobile-windows builds first)
            "name": "AppHost (compound)",
            "type": "coreclr",
            "request": "launch",
            "program": "${workspaceFolder}/src/LearnLuxembourgish.AppHost/bin/Debug/net10.0/LearnLuxembourgish.AppHost.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/LearnLuxembourgish.AppHost",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s"
            },
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "DOTNET_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "Attach to AppHost (show PID first)",
            "type": "coreclr",
            "request": "attach",
            "preLaunchTask": "show-apphost-pid",
            "processId": "${command:pickProcess}"
        },
        {
            // Uses the .NET MAUI extension debugger — prompts to pick an emulator/device.
            // After launching, the Android emulator reaches the API via 10.0.2.2 (host loopback).
            "name": "MAUI: Android",
            "type": "maui",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/LearnLuxembourgish.Mobile/LearnLuxembourgish.Mobile.csproj"
        },
        {
            // Same as above but used in the compound (no duplicate device picker)
            "name": "MAUI: Android (compound)",
            "type": "maui",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/LearnLuxembourgish.Mobile/LearnLuxembourgish.Mobile.csproj"
        }
    ],
    "compounds": [
        {
            "name": "MAUI Windows + AppHost",
            "configurations": ["MAUI: Windows", "AppHost (compound)"],
            "preLaunchTask": "build-mobile-windows",
            "stopAll": true
        },
        {
            // Starts Aspire (API + dashboard) and the MAUI Android debugger together.
            // Start AppHost first so the API is up before the app hits 10.0.2.2.
            "name": "MAUI Android + AppHost",
            "configurations": ["AppHost (compound)", "MAUI: Android (compound)"],
            "stopAll": true
        }
    ]
}